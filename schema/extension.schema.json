{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/MobileStudio-AndroidIDE/MobileStudio-Extensions/main/schema/extension.schema.json",
  "title": "MobileStudio Extension",
  "description": "Manifest describing a MobileStudio extension registered in the MobileStudio-Extensions repository.",
  "type": "object",
  "required": ["id", "name", "version", "author", "description", "download", "minStudioVersion"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique extension ID. Lowercase letters, digits, hyphens, underscores and dots; 3-64 chars; must start with a letter or digit.",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable extension name.",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "description": "Extension version (Semantic Versioning: MAJOR.MINOR.PATCH).",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "author": {
      "type": "string",
      "description": "Extension author (GitHub username or real name).",
      "minLength": 2,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "description": "Short description of what the extension does.",
      "minLength": 8,
      "maxLength": 1024
    },
    "download": {
      "type": "string",
      "description": "HTTPS download URL of the .msext extension package.",
      "pattern": "^https://.+"
    },
    "size": {
      "type": "number",
      "description": "Package size in bytes (from the publish flow).",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "description": "SHA-256 of the published package (generated by the security scan). Empty means pending.",
      "pattern": "^([a-fA-F0-9]{64})?$"
    },
    "minStudioVersion": {
      "type": "string",
      "description": "Minimum MobileStudio version required by this extension (SemVer).",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "minMobileStudioVersion": {
      "type": "string",
      "description": "Alias of minStudioVersion (kept for compatibility).",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "type": {
      "type": "string",
      "description": "Optional extension category/type.",
      "enum": ["syntax", "theme", "template", "toolchain", "language", "formatter", "linter", "snippets", "plugin"]
    },
    "permissions": {
      "type": "array",
      "description": "Permissions the extension requires.",
      "items": { "type": "string", "minLength": 1, "maxLength": 64 },
      "uniqueItems": true,
      "maxItems": 32
    },
    "languages": {
      "type": "array",
      "description": "File types/languages the extension handles.",
      "items": { "type": "string", "minLength": 1, "maxLength": 32 },
      "uniqueItems": true,
      "maxItems": 64
    },
    "license": {
      "type": "string",
      "description": "License identifier (e.g. MIT, Apache-2.0).",
      "maxLength": 64
    },
    "changelog": {
      "type": "string",
      "description": "Changelog for the current version.",
      "maxLength": 4096
    },
    "homepage": {
      "type": "string",
      "description": "Optional homepage/documentation URL (HTTPS).",
      "pattern": "^https://.+"
    },
    "icon": {
      "type": "string",
      "description": "Optional HTTPS URL of the extension icon (png/svg).",
      "pattern": "^https://.+"
    },
    "screenshots": {
      "type": "array",
      "description": "Optional HTTPS URLs of screenshots.",
      "items": { "type": "string", "pattern": "^https://.+" },
      "maxItems": 8
    },
    "tags": {
      "type": "array",
      "description": "Optional search tags.",
      "items": { "type": "string", "minLength": 1, "maxLength": 32 },
      "uniqueItems": true,
      "maxItems": 16
    }
  }
}